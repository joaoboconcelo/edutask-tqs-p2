		{
			"name": "01 - Autenticação - Login Válido (Positivo)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code deve ser 200 OK\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"pm.test(\"Resposta deve conter mensagem de sucesso e dados do usuario\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.message).to.eql(\"Autenticação realizada com sucesso.\");",
							"    pm.expect(jsonData.user).to.be.an(\"object\");",
							"    pm.expect(jsonData.user.email).to.eql(\"aluno@unisagrado.edu.br\");",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"email\": \"aluno@unisagrado.edu.br\",\n    \"password\": \"Senha@123\"\n}"
				},
				"url": {
					"raw": "{{base_url}}/api/auth/login",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"api",
						"auth",
						"login"
					]
				}
			}
		},
