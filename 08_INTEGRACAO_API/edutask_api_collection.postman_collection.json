							"});",
							"pm.test(\"Validar contrato do objeto da disciplina criada\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.discipline).to.have.property(\"id\");",
							"    pm.expect(jsonData.discipline.code).to.eql(\"CC-TEST01\");",
							"    pm.expect(jsonData.discipline.workload_hours).to.eql(80);",
							"    pm.environment.set(\"created_discipline_id\", jsonData.discipline.id);",
							"});"
						],
